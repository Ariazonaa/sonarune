{
  "name": "sonarune",
  "version": "0.5.0",
  "private": true,
  "description": "A fast Jellyfin desktop music client",
  "license": "GPL-3.0-or-later",
  "author": "Ariazonaa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ariazonaa/sonarune.git"
  },
  "homepage": "https://github.com/Ariazonaa/sonarune",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/clean-build.mjs && vite build",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run e2e/wdio.conf.mjs",
    "verify": "node scripts/verify.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "blurhash": "^2.0.5",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "butterchurn-presets-weekly": "^0.0.4",
    "virtua": "^0.49.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.0",
    "@wdio/cli": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "pngjs": "^7.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
