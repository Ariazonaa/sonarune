{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // $app/tsconfig (SvelteKit 3) no longer sets these; without checkJs the
    // .js files below (vite.config.js, the generated src/lib/paraglide) would
    // drop out of type-checking. scripts/ and e2e/ are not included: they are
    // plain Node scripts without JSDoc types and would fail by the hundreds.
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src",
    "vite.config.js",
    "vitest.config.ts"
  ]
}
