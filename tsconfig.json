{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    // $app/tsconfig (SvelteKit 3) no longer sets these; without checkJs the
    // .js files (scripts, vite/vitest config) would drop out of type-checking.
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src",
    "vite.config.js"
  ]
}
